# LedgerLine example configuration (non-secret)
# Copy to .env for local development. Do not commit .env.
# For Neon deployment: replace with your actual Neon connection strings.
# NEVER use the placeholder passwords below in production or shared environments.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local PostgreSQL (Docker/embedded) - for development only
# DATABASE_URL=postgres://ledgerline_app:CHANGE_ME@localhost:5432/ledgerline
# MIGRATIONS_URL=postgres://ledgerline_migrator:CHANGE_ME@localhost:5432/ledgerline

# Neon Free Tier (production) - set these in Render dashboard as SECRET values
# NOTE: DATABASE_URL uses the POOLED endpoint (host contains -pooler);
# MIGRATIONS_URL must use the DIRECT (non-pooler) endpoint because the
# migration runner relies on a session-level advisory lock.
# DATABASE_URL=postgres://ledgerline_app:<password>@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# MIGRATIONS_URL=postgres://ledgerline_migrator:<password>@ep-xxx-direct.us-east-1.aws.neon.tech/neondb?sslmode=require

SESSION_TTL_HOURS=24
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production, set to your actual frontend URL:
# FRONTEND_ORIGINS=https://ledgerline-frontend-prod.onrender.com

# COOKIE_SECURE defaults to true in production (NODE_ENV=production), false otherwise
# COOKIE_SECURE=true
