# LedgerLine example configuration (non-secret)
# Copy to .env for local development. Do not commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://ledgerline_app:ledgerline_app@localhost:5432/ledgerline
MIGRATIONS_URL=postgres://ledgerline_migrator:ledgerline_migrator@localhost:5432/ledgerline
SESSION_TTL_HOURS=24
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
