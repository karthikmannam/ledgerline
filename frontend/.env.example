# Frontend environment configuration
# Copy to .env.local for local development. Do not commit .env.local.

# Local development: Vite dev server proxies to local backend
# VITE_API_BASE_URL=http://localhost:3000

# Production (Render Static Site with rewrites): use relative path for same-origin
# The Render static site rewrites /auth/*, /accounts/*, etc. to the backend
VITE_API_BASE_URL=
